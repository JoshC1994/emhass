name: Trigger Addon Sync

on:
  push:
    branches:
      - '**'

  workflow_dispatch:
    inputs:
      target_branch:
        description: Branch to synchronise
        required: false
        default: ''
        type: string

jobs:
  dispatch-addon-sync:
    name: Dispatch branch data to add-on repository
    runs-on: ubuntu-latest

    steps:
      - name: Check out EMHASS
        uses: actions/checkout@v4
        with:
          ref: ${{ inputs.target_branch || github.ref }}
          fetch-depth: 1

      - name: Calculate version and branch data
        id: values
        shell: bash
        run: |
          set -euo pipefail

          branch="${{ inputs.target_branch || github.ref_name }}"
          commit_sha="$(git rev-parse HEAD)"
          short_sha="$(git rev-parse --short=7 HEAD)"

          base_version="$(
            grep -E '^[[:space:]]*version[[:space:]]*=' pyproject.toml \
              | head -n 1 \
              | sed -E 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*["'\'']([^"'\'']+)["'\''].*/\1/'
          )"

          if [ -z "$base_version" ]; then
            echo "Could not determine base version from pyproject.toml."
            exit 1
          fi

          echo "Branch: $branch"
          echo "Commit SHA: $commit_sha"
          echo "Short SHA: $short_sha"
          echo "Base version: $base_version"

          {
            echo "branch=$branch"
            echo "commit_sha=$commit_sha"
            echo "short_sha=$short_sha"
            echo "base_version=$base_version"
          } >> "$GITHUB_OUTPUT"

      - name: Trigger add-on repository workflow
        uses: peter-evans/repository-dispatch@v3
        with:
          token: ${{ secrets.ADDON_SYNC_TOKEN }}
          repository: JoshC1994/emhass-add-on
          event-type: emhass-branch-sync
          client-payload: >-
            {
              "branch_name": "${{ steps.values.outputs.branch }}",
              "commit_sha": "${{ steps.values.outputs.commit_sha }}",
              "short_sha": "${{ steps.values.outputs.short_sha }}",
              "base_version": "${{ steps.values.outputs.base_version }}"
            }
